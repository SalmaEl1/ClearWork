# Copia este archivo a .env y ajusta los valores.

PORT=4000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://clearwork:clearwork@localhost:5432/clearwork

# Secreto para firmar los JWT. En producción, usa un valor largo y aleatorio
# (por ejemplo: openssl rand -base64 48)
JWT_SECRET=cambia-este-valor-en-desarrollo
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# Solo los usa "npm run seed:admin", para crear el primer usuario admin
# (no hay autoregistro público para ese rol).
ADMIN_EMAIL=admin@clearwork.dev
ADMIN_PASSWORD=cambia-esta-contraseña
ADMIN_FULL_NAME=Administrador ClearWork

# Correo de bienvenida con contraseña provisional al crear una cuenta
# desde el panel de admin. Si se dejan vacías, la creación de cuentas
# sigue funcionando: el admin ve la contraseña en pantalla para
# compartirla a mano en vez de que se envíe por correo.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@tudominio.dev

# URL pública del frontend, para el enlace de login del correo de bienvenida
APP_URL=http://localhost:5173
