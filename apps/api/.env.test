# Configuración solo para `npm test`. Usa una base de datos separada
# (clearwork_test) para no tocar nunca los datos de desarrollo. Sin
# credenciales de SendGrid a propósito: así los tests de correo de
# bienvenida ejercitan siempre la ruta de fallo controlado (contraseña
# devuelta en claro), sin mandar correos reales.
PORT=4001
DATABASE_URL=postgres://clearwork:clearwork@localhost:5432/clearwork_test
JWT_SECRET=test-secret-solo-para-tests-automatizados-0000
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Vacías a propósito (no solo ausentes): si se dejaran sin mencionar aquí,
# config/env.ts (vía `import "dotenv/config"`) rellenaría el hueco con
# las credenciales reales de apps/api/.env, y los tests mandarían correos
# de verdad en vez de ejercitar la ruta de fallo controlado.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
